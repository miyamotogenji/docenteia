# ─────────────────────────────────────────────────────────────────────────────
# MentorIA Math (docenteia) — PMV 1 · variables de entorno
#
# Copia este archivo a ".env" y rellena los valores reales.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# Se usa ".env" (y no ".env.local") como fichero único de desarrollo porque lo
# leen a la vez Next.js, la CLI de Prisma —que sólo lee .env, no .env.local, y
# sin él las migraciones fallan— y los scripts de qa/. Así hay una sola copia de
# la configuración y no se desincronizan.
#
# .env NUNCA se sube al repositorio (ver .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. BASE DE DATOS (PostgreSQL / Supabase) ────────────────────────────────
# Cadena de conexión que usa Prisma. En Supabase se obtiene en:
#   Project Settings → Database → Connection string → URI
#
# IMPORTANTE en Supabase: usa el puerto 6543 (pooler, "Transaction") para la
# aplicación y el puerto 5432 (conexión directa) para las migraciones. Por eso
# hay dos variables: schema.prisma usa DATABASE_URL para consultar y
# DIRECT_URL para migrar.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres"

# Ejemplo para PostgreSQL local de desarrollo (ambas iguales):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docenteia?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/docenteia?schema=public"


# ── 2. AUTENTICACIÓN (NextAuth.js / Auth.js v5) ─────────────────────────────
# Secreto para firmar la sesión. Genera uno con:
#   npx auth secret
#   (o)  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL pública de la aplicación. En local se puede omitir; en producción es
# obligatoria (Vercel la inyecta como NEXTAUTH_URL automáticamente).
# AUTH_URL="http://localhost:3000"

# Permite el uso detrás de un proxy (Vercel, Render). Déjalo en true en la nube.
AUTH_TRUST_HOST="true"


# ── 3. IA GENERATIVA (Google Gemini) ────────────────────────────────────────
# Clave de la API de Gemini. La clave vive SOLO en el entorno del servidor:
# el navegador nunca la ve (no lleva prefijo NEXT_PUBLIC_).
#
# Si se deja vacía, la aplicación arranca en MODO DEMO (LSG simulado), lo que
# permite ejecutar toda la suite de QA sin consumir cuota.
GEMINI_API_KEY=""

# Modelo a usar. El cliente de Gemini tiene fallback automático: si un modelo
# se retira y devuelve 404, prueba el siguiente de la lista y recuerda cuál
# funcionó, de modo que no hay que tocar código cuando Google cambia algo.
GEMINI_MODEL="gemini-2.5-flash-lite"


# ── 3 bis. VOZ NEURONAL DEL TUTOR (opcional) ────────────────────────────────
# Sin ninguna de estas claves el tutor habla con la voz del navegador
# (window.speechSynthesis), que es la que hay hoy: la clase funciona igual.
# Con una de ellas, /api/voz sintetiza cada frase con una voz neuronal en
# español y el navegador la reproduce; la pizarra se sincroniza igual, porque
# el aviso de arranque sigue siendo el momento real en que empieza a sonar.
#
# La clave vive SOLO en el servidor (sin prefijo NEXT_PUBLIC_): el navegador
# pide el audio a /api/voz y nunca ve la clave.
#
# Opción A — Google Cloud Text-to-Speech (voces Neural2):
# GOOGLE_TTS_API_KEY=""
# GOOGLE_TTS_VOZ="es-US-Neural2-B"     # masculina, como la voz actual del tutor
# GOOGLE_TTS_VELOCIDAD="0.96"
# GOOGLE_TTS_TONO="-1"
#
# Opción B — ElevenLabs:
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""
# ELEVENLABS_MODELO="eleven_multilingual_v2"
#
# Con las dos puestas, manda VOZ_PROVEEDOR ("google" | "elevenlabs").
# VOZ_PROVEEDOR="google"


# ── 4. ENTORNO DE PRUEBAS (QA) ──────────────────────────────────────────────
# URL contra la que corre la suite de qa/. Por defecto http://localhost:3000,
# de modo que toda la validación se ejecuta en local sin depender de Render.
BASE_URL="http://localhost:3000"

# Parámetros del barrido por propiedades (qa/barrido.mjs).
# BARRIDO_TURNOS=8
# BARRIDO_SEC=14


# ── 5. SERVIDOR ─────────────────────────────────────────────────────────────
# Puerto de la aplicación Next.js (por defecto 3000).
# PORT=3000
