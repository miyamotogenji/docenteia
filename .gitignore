# Variables de entorno — NINGUNA se sube al repositorio.
# Se usa `.env` como fichero único de desarrollo local: lo leen a la vez Next.js,
# la CLI de Prisma (migraciones y semilla) y los scripts de qa/. `.env.local`
# queda igualmente ignorado por si se prefiere separar secretos.
.env
.env.local
.env.*.local

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Prisma
/prisma/*.db
/prisma/*.db-journal

