{
  "name": "docenteia",
  "version": "1.0.0",
  "private": true,
  "description": "MentorIA Math — MVP 2. HITO 1: autoría docente, catálogo curricular dinámico y validador matemático en servidor, sobre la base del PMV 1 (Next.js App Router + TypeScript + PostgreSQL/Prisma).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && node --experimental-strip-types prisma/seed.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "test": "node qa/diagnostico.mjs && node qa/preflight.mjs && node qa/paso1.mjs && node qa/hito1.mjs && node qa/matematicas.mjs && node qa/diagnostico-nivel.mjs && node qa/qa.mjs && node qa/frontend.mjs && node qa/sesiones.mjs && node qa/aceptacion.mjs && node qa/leccion.mjs && node qa/barrido.mjs",
    "qa:preflight": "node qa/preflight.mjs",
    "qa:diagnostico": "node qa/diagnostico.mjs",
    "qa:leccion": "node qa/leccion.mjs",
    "qa": "node qa/qa.mjs",
    "qa:frontend": "node qa/frontend.mjs",
    "qa:sesiones": "node qa/sesiones.mjs",
    "qa:aceptacion": "node qa/aceptacion.mjs",
    "qa:barrido": "node qa/barrido.mjs",
    "qa:todo": "npm test",
    "legacy:start": "node server.js",
    "qa:paso1": "node qa/paso1.mjs",
    "qa:hito1": "node qa/hito1.mjs",
    "qa:matematicas": "node qa/matematicas.mjs",
    "qa:diagnostico-nivel": "node qa/diagnostico-nivel.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.15.0",
    "katex": "^0.16.19",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
